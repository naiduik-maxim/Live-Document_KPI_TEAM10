# Copy to .env; replace these local development placeholders before shared use.
POSTGRES_DB=living_documents
POSTGRES_USER=living_documents
POSTGRES_PASSWORD=local-development-change-me
DJANGO_SECRET_KEY=local-development-only-replace-with-a-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_PORT=8080
